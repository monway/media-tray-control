class JellyfinTray:
    def __init__(self):
        self._apply_luxury_theme()
        self.backend = SystemdBackend("jellyfin.service")
        self.about_window, self.log_window, self._action_locked = None, None, False
        self.indicator = AppIndicator3.Indicator.new("media-tray-control", "jf-inactive", AppIndicator3.IndicatorCategory.APPLICATION_STATUS)
        self.indicator.set_icon_theme_path(ICON_DIR)
        self.indicator.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
        self.menu = Gtk.Menu()
        self._build_widget_tree()
        self.indicator.set_menu(self.menu)
        self._update_ui_state()
        GLib.timeout_add_seconds(3, self._update_ui_state)

    def _apply_luxury_theme(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(LUXURY_CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def _build_widget_tree(self):
        self.item_status = Gtk.MenuItem(label="Checking...")
        self.item_status.set_sensitive(False)
        self.item_status.set_name("status-header")
        self.menu.append(self.item_status)
        self.menu.append(Gtk.SeparatorMenuItem())
        item_web = Gtk.MenuItem(label="Open Web Client")
        item_web.connect("activate", lambda w: SecurityGuard.run_bg(["xdg-open", "http://localhost:8096"]))
        self.menu.append(item_web)
        item_dir_data = Gtk.MenuItem(label="Browse Media Data (WIP) (/var/lib)")
        item_dir_data.set_sensitive(False)
        item_dir_data.set_tooltip_text("Under Construction: State handling pending.")
        item_dir_data.connect("activate", lambda w: SecurityGuard.run_bg(["xdg-open", "/var/lib/jellyfin"]))
        self.menu.append(item_dir_data)
        item_logs = Gtk.MenuItem(label="View Server Logs (WIP)")
        item_logs.set_sensitive(False)
        item_logs.set_tooltip_text("Under Construction: Pending security review.")
        item_logs.connect("activate", self._show_logs)
        self.menu.append(item_logs)
        self.menu.append(Gtk.SeparatorMenuItem())
        self.item_toggle = Gtk.MenuItem(label="Start Service")
        self.item_toggle.connect("activate", self._on_toggle_clicked)
        self.menu.append(self.item_toggle)
        self.item_restart = Gtk.MenuItem(label="Restart Service")
        self.item_restart.connect("activate", lambda w: self.backend.restart_service())
        self.menu.append(self.item_restart)
        self.menu.append(Gtk.SeparatorMenuItem())
        item_about = Gtk.MenuItem(label="About")
        item_about.connect("activate", self._show_about)
        self.menu.append(item_about)
        item_quit = Gtk.MenuItem(label="Quit Tray")
        item_quit.connect("activate", lambda w: Gtk.main_quit())
        self.menu.append(item_quit)
        self.menu.show_all()

    def _update_ui_state(self):
        is_running = self.backend.is_active()
        GLib.idle_add(self._apply_state_to_widgets, is_running)
        return True 

    def _apply_state_to_widgets(self, is_running):
        if is_running:
            self.indicator.set_icon_full("jf-active", "Jellyfin Active")
            self.item_status.set_label("🟢 Jellyfin: Active")
            self.item_toggle.set_label("Stop Service")
        else:
            self.indicator.set_icon_full("jf-inactive", "Jellyfin Inactive")
            self.item_status.set_label("🔴 Jellyfin: Inactive")
            self.item_toggle.set_label("Start Service")

    def _on_toggle_clicked(self, widget):
        if self._action_locked: return 
        self._action_locked = True
        if self.backend.is_active(): self.backend.stop_service()
        else: self.backend.start_service()
        self._update_ui_state()
        GLib.timeout_add(2500, self._release_lock)

    def _release_lock(self):
        self._action_locked = False
        return False

    def _show_logs(self, widget):
        if self.log_window is not None: self.log_window.present(); return
        self.log_window = LogViewer()
        self.log_window.connect("destroy", self._on_log_destroyed)
        self.log_window.show_all(); self.log_window.present()
    def _on_log_destroyed(self, widget): self.log_window = None

    def _show_about(self, widget):
        if self.about_window is not None: self.about_window.present(); return
        self.about_window = PureLandAbout()
        self.about_window.connect("destroy", self._on_about_destroyed)
        self.about_window.show_all(); self.about_window.present()
    def _on_about_destroyed(self, widget): self.about_window = None 

