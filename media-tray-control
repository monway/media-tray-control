class SystemdBackend:
    def __init__(self, service_name="jellyfin.service"):
        self.service_name = service_name
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self.DEST = "org.freedesktop.systemd1"
        self.PATH = "/org/freedesktop/systemd1"
        self.MANAGER_IFACE = "org.freedesktop.systemd1.Manager"
        self.UNIT_IFACE = "org.freedesktop.systemd1.Unit"
    def is_active(self):
        try:
            res = self.bus.call_sync(self.DEST, self.PATH, self.MANAGER_IFACE, "GetUnit", GLib.Variant("(s)", (self.service_name,)), None, Gio.DBusCallFlags.NONE, -1, None)
            prop = self.bus.call_sync(self.DEST, res.unpack()[0], "org.freedesktop.DBus.Properties", "Get", GLib.Variant("(ss)", (self.UNIT_IFACE, "ActiveState")), None, Gio.DBusCallFlags.NONE, -1, None)
            return prop.unpack()[0] == "active"
        except Exception: return False
    def start_service(self): self._dispatch_action("StartUnit")
    def stop_service(self): self._dispatch_action("StopUnit")
    def restart_service(self): self._dispatch_action("RestartUnit")
    def _dispatch_action(self, method_name):
        self.bus.call(self.DEST, self.PATH, self.MANAGER_IFACE, method_name, GLib.Variant("(ss)", (self.service_name, "replace")), None, Gio.DBusCallFlags.NONE, -1, None, lambda b, r, d: b.call_finish(r), None)

class SecurityGuard:
    @staticmethod
    def run_bg(cmd_list):
        threading.Thread(target=subprocess.run, args=(cmd_list,), kwargs={"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL, "env": os.environ.copy()}, daemon=True).start()

class LogViewer(Gtk.Window):
    def __init__(self):
        super().__init__(title="Jellyfin Server Logs")
        self.set_default_size(750, 450)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.get_style_context().add_class("log-canvas")
        self.process, self.thread, self._is_destroyed = None, None, False
        scrolled = Gtk.ScrolledWindow()
        self.add(scrolled)
        self.textview = Gtk.TextView()
        self.textview.set_editable(False)
        self.textview.set_cursor_visible(False)
        self.textview.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.textview.get_style_context().add_class("log-text")
        scrolled.add(self.textview)
        self.connect("delete-event", self._on_close)
        self._start_logging()
    def _start_logging(self):
        try:
            self.process = subprocess.Popen(["journalctl", "-u", "jellyfin.service", "-n", "100", "-f"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            self.thread = threading.Thread(target=self._read_logs, daemon=True)
            self.thread.start()
        except Exception as e: self._append_log(f"Error initializing logs: {e}\n")
    def _read_logs(self):
        for line in iter(self.process.stdout.readline, ''):
            if self._is_destroyed: break
            if line: GLib.idle_add(self._append_log, line)
    def _append_log(self, text):
        if self._is_destroyed: return False
        buffer = self.textview.get_buffer()
        buffer.insert(buffer.get_end_iter(), text)
        self.textview.scroll_to_mark(buffer.create_mark(None, buffer.get_end_iter(), False), 0.0, True, 0.0, 1.0)
        return False
    def _on_close(self, widget, event):
        self._is_destroyed = True
        if self.process: self.process.terminate(); self.process.wait()
        self.destroy()

